# Filled in by `neon env pull` / `neon deploy` (written to .env.local).
# On Vercel, set DATABASE_URL in Project Settings > Environment Variables.

# Pooled connection (-pooler host): used by the app at runtime.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require

# Direct connection: used only by `npm run db:migrate`.
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require

# Password for the admin wish ledger at /admin. At least 12 characters.
# Generate one with: openssl rand -base64 30
ADMIN_PASSWORD=
